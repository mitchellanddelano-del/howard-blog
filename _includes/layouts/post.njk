---
layout: layouts/base.njk
---

<main class="post-wrap">
  <a class="post-back" href="/">← Back to home</a>

  <article class="post-card">
    <div class="post-meta">{{ date | displayDate }}</div>
    <h1 class="post-title">{{ title }}</h1>
    <div class="post-content">
      {{ content | safe }}
    </div>
  </article>
</main>
