---
layout: layouts/base.njk
title: Entries
description: Complete archive of Howard Mason entries.
---

<main class="page-shell archive-page">
  <section class="section archive-section">

    {% set postsByYear = collections.posts | groupByYear %}

    {% for year, posts in postsByYear %}
      <div class="archive-year">
        <h2 class="archive-year-heading">{{ year }}</h2>

        <div class="archive-list">
          {% for post in posts %}
            <a class="archive-card" href="{{ post.url }}">
              <div class="archive-card__meta">{{ post.data.date | displayDate }}</div>
              <h3>{{ post.data.title }}</h3>
              <p>{{ post.data.excerpt or "New entry from Howard Mason." }}</p>
            </a>
          {% endfor %}
        </div>
      </div>
    {% endfor %}

  </section>
</main>
