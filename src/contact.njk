---
layout: layouts/base.njk
title: Contact
description: Get in touch with Broward Mason.
---

<main class="page-shell">
  <section class="section contact-page">

    <div class="section-head">
      <p class="section-label">Contact</p>
      <h2>Reach Howard</h2>
    </div>

    <div class="contact-grid">

      <div class="contact-copy">
        <p>
          Questions, speaking inquiries, and personal notes are always welcome.
        </p>

        <p>
          If something’s on your mind, feel free to send it along. Messages go directly to Howard, and he reads every one — even if replies may take a little time.
        </p>
      </div>

      <div class="contact-form-wrap">

        <!-- NETLIFY FORM -->
        <form
          name="contact"
          method="POST"
          action="/thank-you/"
          data-netlify="true"
          netlify
          netlify-honeypot="bot-field"
        >
          <!-- REQUIRED hidden input -->
          <input type="hidden" name="form-name" value="contact">

          <!-- honeypot -->
          <p class="hidden-field">
            <label>Don’t fill this out if you're human:
              <input name="bot-field">
            </label>
          </p>

          <div class="form-field">
            <label for="contact-name">Name</label>
            <input id="contact-name" type="text" name="name" required>
          </div>

          <div class="form-field">
            <label for="contact-email">Email</label>
            <input id="contact-email" type="email" name="email" required>
          </div>

          <div class="form-field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required></textarea>
          </div>

          <button type="submit" class="btn btn--solid">
            Send message
          </button>
        </form>

      </div>

    </div>

  </section>
</main>
