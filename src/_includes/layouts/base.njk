<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} | {% endif %}Howard Mason</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}Notes, reflections, local observations, and stories from Howard Mason.{% endif %}">

  <link rel="stylesheet" href="/assets/styles.css">

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="shortcut icon" href="/assets/favicon.ico">

  <!-- Netlify Identity -->
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>

<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/">Howard Mason</a>

      <nav class="nav" aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/entries/">Entries</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>
        Officially unofficial. Howard Mason in partnership with
        <a href="https://mitchellanddelano.com" target="_blank" rel="noopener">Mitchell &amp; Delano</a>.
      </p>
    </div>
  </footer>

  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function(user) {
        if (!user && window.location.hash) {
          window.netlifyIdentity.open();
        }
      });
    }
  </script>
</body>
</html>
