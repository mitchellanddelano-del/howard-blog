<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} | {% endif %}Howard Mason</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}Notes, reflections, local observations, and stories from Howard Mason.{% endif %}">

  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="icon" href="/favicon.ico">
</head>
<body>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/">Howard Mason</a>

      <nav class="nav" aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/entries/">Entries</a>
        <a href="/contact/">Contact</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>Officially unofficial. Howard Mason in partnership with Mitchell &amp; Delano.</p>
    </div>
  </footer>
</body>
</html>
